# Copy to .env for local development. .env is git-ignored; never commit real values.
# In production these come from GitHub Actions secrets and variables (spec section 13).

# --- Product
PRODUCT_NAME=Digest                     # name shown everywhere; placeholder until Phase 6
SITE_URL=                               # public base URL, e.g. https://<project>.pages.dev
EDITION_LANG=en                         # en | sv
TZ=Europe/Stockholm                     # local time for schedules and daily caps
CONFIG_DIR=config                       # where the YAML config files live

# --- Summaries
SUMMARY_MODE=llm                        # llm | links (no generative AI)
FALLBACK_TO_LINKS=true                  # links cards for selected clusters without an approved summary
TEMPLATE_STORIES=true                   # template stories from enabled open-data sources
CLUSTER_METHOD=embeddings               # embeddings | tfidf (no ML)
SUMMARY_WORDS_MIN=30
SUMMARY_WORDS_MAX=60

# --- State
STATE_STORE=local_file                  # github_release in production; local_file for development
STATE_PATH=.state/digest.sqlite         # local working copy (git-ignored)
STATE_RELEASE_TAG=pipeline-state        # release in the content repository that holds state files
CONTENT_REPO=                           # private content repository, owner/name
CONTENT_REPO_TOKEN=                     # fine-grained token: content repository only, contents + pull requests

# --- LLM providers
LLM_PROVIDERS_FILE=config/llm_providers.yaml
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_AI_TOKEN=                    # optional extra capacity
OPENROUTER_API_KEY=                     # optional extra capacity
ANTHROPIC_API_KEY=                      # optional paid upgrade
LLM_DAILY_BUDGET_USD=0                  # hard daily cap on paid AI calls; 0 = no paid calls at all
USE_STRONG_MODEL_FOR_TOP=false          # strong (paid) model for top stories
LLM_MAX_INPUT_TOKENS=5000               # per-call input cap, to stay under per-minute limits

# --- Run and retention
RUN_TIME_BUDGET_MINUTES=11              # a run stops starting new work after this
FULLTEXT_RETENTION_HOURS=72             # purge window for article text (hard rule)
ITEM_RETENTION_DAYS=30                  # delete items this long after their cluster closes
AUTO_PUBLISH=false                      # publish approved, non-sensitive stories without review

# --- Hosting
STATIC_HOST=cloudflare_pages            # cloudflare_pages | cloudflare_workers | github_pages
MIN_MINUTES_BETWEEN_DEPLOYS=30
CLOUDFLARE_API_TOKEN=                   # Pages edit only
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=

# --- Alerts
ALERT_WEBHOOK_URL=                      # ntfy topic URL (long random topic name)
HEALTHCHECK_URL=                        # Healthchecks.io ping URL
BOT_CONTACT_URL=                        # default ${SITE_URL}/bot; shown in the User-Agent

# --- Integration test only (tests/test_state_integration.py)
DIGEST_IT_CONTENT_REPO=
DIGEST_IT_TOKEN=
