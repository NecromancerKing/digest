{% extends "base.html.j2" %}
{% from "_parts.html.j2" import icon, story_card %}
{% block title %}{{ t('site.list_title', name=c.name(lang)) }} · {{ product }}{% endblock %}
{% block description %}{{ t('site.list_description', name=c.name(lang)) }}{% endblock %}
{% block path %}/c/{{ c.slug }}/{% endblock %}
{% block main %}
<div class="wrap c-{{ c.color }}">
<header class="band">
<span class="icon-tile" aria-hidden="true">{{ icon(c.icon, 22) }}</span>
<div><h1 class="serif">{{ c.name(lang) }}</h1><p class="muted">{{ t('site.category_sub', n=items|length) }}</p></div>
</header>
{% if items %}
<div class="list-cards">
{% for s in items %}{{ story_card(s, "h2") }}{% endfor %}
</div>
{% else %}
<p class="empty">{{ t('site.section_empty') }}</p>
{% endif %}
<p class="list-more"><a class="link" href="/archive">{{ t('site.older_in_archive') }}</a></p>
</div>
{% endblock %}
