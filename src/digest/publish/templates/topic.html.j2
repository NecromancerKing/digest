{% extends "base.html.j2" %}
{# D32: one name's stories on the site as a timeline, newest day first. #}
{% from "_parts.html.j2" import icon, story_card %}
{% block title %}{{ t('site.topic_title', name=tp.name) }} · {{ product }}{% endblock %}
{% block description %}{{ t('site.topic_description', name=tp.name, n=tp.stories|length, date=since) }}{% endblock %}
{% block path %}{{ tp.url }}{% endblock %}
{% block main %}
<div class="wrap c-teal">
<nav class="crumbs" aria-label="{{ t('site.breadcrumb') }}">
<a class="back pill" href="/"><span>{{ icon('back', 16, 2) }}{{ t('site.top_stories') }}</span></a>
<span aria-hidden="true">/</span>
<a class="srcl" href="/topics">{{ t('site.link.topics') }}</a>
</nav>
<header class="band">
<span class="icon-tile" aria-hidden="true">{{ icon(topic_icon(tp.kind), 22) }}</span>
<div><h1 class="serif">{{ tp.name }}</h1><p class="muted">{{ t('site.topic_sub', n=tp.stories|length, date=since) }}</p></div>
</header>
{% for day, items in days %}
<section class="day-group" aria-labelledby="day-{{ day }}">
<h2 class="serif" id="day-{{ day }}">{{ long_day(day) }}</h2>
<div class="list-cards">
{% for s in items %}{{ story_card(s) }}{% endfor %}
</div>
</section>
{% endfor %}
{% if shown < tp.stories|length %}
<p class="list-more">{{ t('site.topic_capped', shown=shown, n=tp.stories|length) }} <a class="link" href="/archive">{{ t('site.link.archive') }}</a></p>
{% endif %}
{% if related %}
<section class="day-group" aria-labelledby="related-h">
<h2 class="serif" id="related-h">{{ t('site.related_topics') }}</h2>
<ul class="topic-list">{% for x in related %}<li><a class="pill" href="{{ x.url }}"><span>{{ x.name }}</span></a></li>{% endfor %}</ul>
</section>
{% endif %}
<p class="list-more"><a class="link" href="/topics">{{ t('site.link.topics') }}</a></p>
</div>
{% endblock %}
